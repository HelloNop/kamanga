{
  "name": "kamanga",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "auth:create-admin": "bun run src/db/create-admin.ts",
    "check:listings": "bun run src/features/listings/lib/format.check.ts",
    "check:locations": "bun run src/features/locations/lib/csv.check.ts",
    "db:seed-reference": "bun run src/db/seed-reference.ts",
    "check:listing-import": "bun run src/features/listings/lib/csv-import.check.ts",
    "db:make-dummy": "bun run src/db/make-dummy.ts",
    "db:seed-dummy": "bun run src/db/seed-dummy.ts",
    "db:clear-dummy": "bun run src/db/clear-dummy.ts",
    "db:seed-contoh": "bun run src/db/seed-contoh.ts",
    "db:clear-contoh": "bun run src/db/clear-contoh.ts",
    "db:purge-chat": "bun run src/db/purge-chat.ts",
    "db:fresh": "bun run src/db/fresh.ts && bun run db:migrate && bun run db:seed-reference && bun run auth:create-admin",
    "db:fresh:dummy": "bun run db:fresh && bun run db:seed-dummy",
    "check:ranking": "bun run src/lib/directory/ranking.check.ts",
    "check:search": "bun run src/lib/directory/search.check.ts",
    "check:extract": "bun run src/lib/kamanga-ai/extract.check.ts",
    "check:chat": "bun run src/lib/kamanga-ai/chat.check.ts",
    "check:queue": "bun run src/lib/kamanga-ai/queue.check.ts",
    "eval:chat": "bun run src/lib/kamanga-ai/eval/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.47",
    "@base-ui/react": "^1.6.0",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.44",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.3",
    "input-otp": "^1.4.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.8.9",
    "pg": "^8.23.1",
    "postcss": "8.5.25",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.4.1",
    "sharp": "^0.35.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "5.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.25",
    "sharp": "^0.35.3"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  }
}
